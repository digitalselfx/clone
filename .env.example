# Railway Postgres connection string (Settings > Connect on your Postgres instance)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

PORT=3000

# Used to strip the subdomain from incoming requests, e.g. vladimir.digital-selfx.com -> slug 'vladimir'
ROOT_DOMAIN=digital-selfx.com
